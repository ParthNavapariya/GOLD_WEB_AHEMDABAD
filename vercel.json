    },
    {
      "source": "/airo-assets/images/pages/services/hero",
      "destination": "/airo-assets/images/pages/services/hero.jpg"
    },
    {
      "source": "/airo-assets/images/pages/about/hero",
      "destination": "/airo-assets/images/pages/about/hero.jpg"
    },
    {
      "source": "/airo-assets/images/pages/about/team-trading-floor",
